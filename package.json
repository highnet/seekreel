{
  "name": "seekreel",
  "version": "0.1.0",
  "description": "Turn an animated web page into a video file, rendering it one frame at a time.",
  "license": "MIT",
  "author": "highnet",
  "repository": { "type": "git", "url": "git+https://github.com/highnet/seekreel.git" },
  "homepage": "https://github.com/highnet/seekreel#readme",
  "bugs": "https://github.com/highnet/seekreel/issues",
  "keywords": ["video", "animation", "gsap", "playwright", "ffmpeg", "mp4", "frame", "deterministic", "marketing"],
  "type": "module",
  "bin": { "seekreel": "bin/seekreel.js" },
  "files": ["bin", "src", "templates", "scripts", "README.md", "LICENSE"],
  "engines": { "node": ">=20" },
  "scripts": {
    "example": "node bin/seekreel.js build --config examples/collection-dex/seekreel.config.json"
  },
